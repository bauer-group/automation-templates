# Fixture configuration for the backup round-trip self-test.
# Mirrors a consumer .env.example: production defaults, no secrets.

# Generated at runtime by the module (generated-secrets: DATABASE_PASSWORD).
DATABASE_PASSWORD=

# base64 of 32 random bytes. Filled by prepare.sh (prepare-script), the way a
# repository's own env generator fills secrets with a specific format.
APP_SIGNING_KEY=

# Export from an external service - enabled in production, switched off in CI
# through env-overrides because the service is not reachable from a runner.
SAAS_EXPORT_ENABLED=true

# Empty bucket = local only (the engine skips the S3 destination).
BACKUP_S3_BUCKET=

# Image of the backup sidecar. The self-test builds ./backup and tags it with
# exactly this reference, so Compose starts the build instead of pulling.
BACKUP_IMAGE=roundtrip-fixture/backup
BACKUP_VERSION=ci

# External proxy network of the reverse-proxy variant (docker-compose.proxy.yml).
# On a real host the proxy owns it; the self-test creates it (external-networks).
PROXY_NETWORK=roundtrip-proxy
